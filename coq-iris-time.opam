opam-version: "2.0"
maintainer: "Glen Mével"
authors: "Glen Mével, Jacques-Henri Jourdan, François Pottier, Armaël Guéneau, Arthur Charguéraud"
homepage: "https://gitlab.inria.fr/gmevel/iris-time-proofs"
bug-reports: "https://gitlab.inria.fr/gmevel/iris-time-proofs/issues"
dev-repo: "git+https://gitlab.inria.fr/gmevel/iris-time-proofs.git"

synopsis: "Iris with time credits and time credits"

depends: [
  "rocq-core"
  "rocq-stdlib"
  "rocq-iris" { (= "4.5.0" ) }
  "rocq-iris-heap-lang" { (= "4.5.0" ) }
]

build: [make "-j%{jobs}%"]
install: [make "install"]
